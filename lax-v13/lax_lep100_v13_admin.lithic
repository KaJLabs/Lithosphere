contract LithosphereAlgorithmic {
    const DECIMALS: u64 = 18;
    const INITIAL_SUPPLY: u256 = 10000000000000000000000000000;
    const UNLIMITED: u256 = 115792089237316195423570985008687907853269984665640564039457584007913129639935;
    const ZERO_ADDRESS: address = 0x0000000000000000000000000000000000000000;
    const INITIAL_HOLDER: address = 0x8FDbEe6b479dcaE4627b71D9b053FCa996836aAF;
    const INITIAL_ADMIN: address = 0x602699FA64Ab8f981e074E267bAe633d389b78Da;

    state {
        initialized: bool;
        name: string;
        symbol: string;
        initial_holder: address;
        admin: address;
        pending_admin: address;
        paused: bool;
        total_supply: u256;
        balances: map<address, u256>;
        allowances: map<address, map<address, u256>>;
        frozen: map<address, bool>;
    }

    event Transfer { from: address, to: address, amount: u256 }
    event Approval { owner: address, spender: address, amount: u256 }
    event AdminTransferStarted { current: address, pending: address }
    event AdminTransferCancelled { current: address, pending: address }
    event AdminTransferred { previous: address, next: address }
    event Paused { account: address }
    event Unpaused { account: address }
    event Frozen { account: address }
    event Unfrozen { account: address }

    pub fn name() -> string { return self.name; }
    pub fn symbol() -> string { return self.symbol; }
    pub fn decimals() -> u64 { return DECIMALS; }
    pub fn total_supply() -> u256 { return self.total_supply; }
    pub fn balance_of(account: address) -> u256 { return self.balances[account]; }
    pub fn allowance(owner: address, spender: address) -> u256 {
        return self.allowances[owner][spender];
    }
    pub fn admin() -> address { return self.admin; }
    pub fn pending_admin() -> address { return self.pending_admin; }
    pub fn paused() -> bool { return self.paused; }
    pub fn is_frozen(account: address) -> bool { return self.frozen[account]; }

    pub fn initialize(initial_holder: address, admin: address, name: string, symbol: string) -> bool {
        require(self.initialized == false);
        require((initial_holder == ZERO_ADDRESS) == false);
        require(initial_holder == INITIAL_HOLDER);
        require((admin == ZERO_ADDRESS) == false);
        require(admin == INITIAL_ADMIN);
        self.initialized = true;
        self.name = name;
        self.symbol = symbol;
        self.initial_holder = initial_holder;
        self.admin = admin;
        self.total_supply = INITIAL_SUPPLY;
        self.balances[initial_holder] = INITIAL_SUPPLY;
        emit AdminTransferred { previous: ZERO_ADDRESS, next: admin };
        emit Transfer { from: ZERO_ADDRESS, to: initial_holder, amount: INITIAL_SUPPLY };
        return true;
    }

    // Holder operations: blocked while paused and for frozen accounts (sender, recipient and spender).
    pub fn transfer(to: address, amount: u256) -> bool {
        require((msg.sender == ZERO_ADDRESS) == false);
        require((to == ZERO_ADDRESS) == false);
        require(self.paused == false);
        require(self.frozen[msg.sender] == false);
        require(self.frozen[to] == false);
        let from_balance: u256 = self.balances[msg.sender];
        require(from_balance >= amount);
        self.balances[msg.sender] = from_balance - amount;
        self.balances[to] = self.balances[to] + amount;
        emit Transfer { from: msg.sender, to: to, amount: amount };
        return true;
    }

    pub fn approve(spender: address, amount: u256) -> bool {
        require((msg.sender == ZERO_ADDRESS) == false);
        require((spender == ZERO_ADDRESS) == false);
        require(self.paused == false);
        require(self.frozen[msg.sender] == false);
        require(self.frozen[spender] == false);
        self.allowances[msg.sender][spender] = amount;
        emit Approval { owner: msg.sender, spender: spender, amount: amount };
        return true;
    }

    pub fn transfer_from(from: address, to: address, amount: u256) -> bool {
        require((msg.sender == ZERO_ADDRESS) == false);
        require((from == ZERO_ADDRESS) == false);
        require((to == ZERO_ADDRESS) == false);
        require(self.paused == false);
        require(self.frozen[msg.sender] == false);
        require(self.frozen[from] == false);
        require(self.frozen[to] == false);
        let allowed: u256 = self.allowances[from][msg.sender];
        let from_balance: u256 = self.balances[from];
        require(allowed >= amount);
        require(from_balance >= amount);
        if (allowed == UNLIMITED) == false {
            self.allowances[from][msg.sender] = allowed - amount;
            if amount >= 1 {
                emit Approval { owner: from, spender: msg.sender, amount: allowed - amount };
            }
        }
        self.balances[from] = from_balance - amount;
        self.balances[to] = self.balances[to] + amount;
        emit Transfer { from: from, to: to, amount: amount };
        return true;
    }

    pub fn burn(amount: u256) -> bool {
        require((msg.sender == ZERO_ADDRESS) == false);
        require(self.paused == false);
        require(self.frozen[msg.sender] == false);
        let balance: u256 = self.balances[msg.sender];
        require(balance >= amount);
        self.balances[msg.sender] = balance - amount;
        self.total_supply = self.total_supply - amount;
        emit Transfer { from: msg.sender, to: ZERO_ADDRESS, amount: amount };
        return true;
    }

    // Admin operations (the LithoVault). They remain available while paused so supply and
    // account controls can still be managed during an incident.
    pub fn mint(to: address, amount: u256) -> bool {
        require((msg.sender == ZERO_ADDRESS) == false);
        require(msg.sender == self.admin);
        require((to == ZERO_ADDRESS) == false);
        require(self.frozen[to] == false);
        self.total_supply = self.total_supply + amount;
        self.balances[to] = self.balances[to] + amount;
        emit Transfer { from: ZERO_ADDRESS, to: to, amount: amount };
        return true;
    }

    pub fn admin_burn(from: address, amount: u256) -> bool {
        require((msg.sender == ZERO_ADDRESS) == false);
        require(msg.sender == self.admin);
        require((from == ZERO_ADDRESS) == false);
        let balance: u256 = self.balances[from];
        require(balance >= amount);
        self.balances[from] = balance - amount;
        self.total_supply = self.total_supply - amount;
        emit Transfer { from: from, to: ZERO_ADDRESS, amount: amount };
        return true;
    }

    pub fn freeze(account: address) -> bool {
        require((msg.sender == ZERO_ADDRESS) == false);
        require(msg.sender == self.admin);
        require((account == ZERO_ADDRESS) == false);
        require((account == self.admin) == false);
        require(self.frozen[account] == false);
        self.frozen[account] = true;
        emit Frozen { account: account };
        return true;
    }

    pub fn unfreeze(account: address) -> bool {
        require((msg.sender == ZERO_ADDRESS) == false);
        require(msg.sender == self.admin);
        require(self.frozen[account]);
        self.frozen[account] = false;
        emit Unfrozen { account: account };
        return true;
    }

    pub fn pause() -> bool {
        require((msg.sender == ZERO_ADDRESS) == false);
        require(msg.sender == self.admin);
        require(self.paused == false);
        self.paused = true;
        emit Paused { account: msg.sender };
        return true;
    }

    pub fn unpause() -> bool {
        require((msg.sender == ZERO_ADDRESS) == false);
        require(msg.sender == self.admin);
        require(self.paused);
        self.paused = false;
        emit Unpaused { account: msg.sender };
        return true;
    }

    // Two-step admin handover: the current admin proposes, the new admin must accept.
    pub fn transfer_admin(next: address) -> bool {
        require((msg.sender == ZERO_ADDRESS) == false);
        require(msg.sender == self.admin);
        require((next == ZERO_ADDRESS) == false);
        require((next == self.admin) == false);
        self.pending_admin = next;
        emit AdminTransferStarted { current: msg.sender, pending: next };
        return true;
    }

    pub fn cancel_admin_transfer() -> bool {
        require((msg.sender == ZERO_ADDRESS) == false);
        require(msg.sender == self.admin);
        require((self.pending_admin == ZERO_ADDRESS) == false);
        let pending: address = self.pending_admin;
        self.pending_admin = ZERO_ADDRESS;
        emit AdminTransferCancelled { current: msg.sender, pending: pending };
        return true;
    }

    pub fn accept_admin() -> bool {
        require((msg.sender == ZERO_ADDRESS) == false);
        require((self.pending_admin == ZERO_ADDRESS) == false);
        require(msg.sender == self.pending_admin);
        let previous: address = self.admin;
        self.admin = msg.sender;
        self.pending_admin = ZERO_ADDRESS;
        self.frozen[msg.sender] = false;
        emit AdminTransferred { previous: previous, next: msg.sender };
        return true;
    }
}
