PORT=4000
CORS_ORIGINS=http://localhost:3002,http://localhost:3000

# Production requires a completed, audited copy of
# ../infra/network.mainnet.template.json mounted read-only at this absolute path.
# Historical testnet defaults are rejected in production.
MULTX_NETWORK_CONFIG_FILE=/run/config/multx-mainnet-network.json

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=bridge_user
DB_PASSWORD_FILE=/run/secrets/multx_db_password
DB_NAME=bridge

# Testnet/development fallback only. Production reads RPCs from the manifest.
LITHO_RPC_WS=wss://rpc-3.litho.ai:8546
LITHO_RPC_HTTP=https://rpc-3.litho.ai

# Bridge contract addresses (leave empty to disable bridge listener)
BRIDGE_CONTRACT_ADDRESS=
BRIDGE_CONTRACT_SEPOLIA=
BRIDGE_CONTRACT_BNB=

# Signature threshold (must match contract signaturesRequired)
SIGNATURES_REQUIRED=3

# ── Release executor (releaseService) ────────────────────────────────────
# When set, this EOA submits releaseTokens on the destination bridge for
# `signed` transfers (lock → sign → release, hands-off). It must hold gas on
# EVERY destination chain it serves (Kamet 900523 + Makalu 700777 for Route 1).
# Leave empty to disable the executor and keep releases on the manual/claim path.
RELAYER_PRIVATE_KEY_FILE=/run/secrets/multx_relayer_private_key
RELEASE_INTERVAL_MS=5000

# Makalu (Route 1) RPC + bridge — destination for Kamet→Makalu releases
MAKALU_RPC_HTTP=https://rpc.litho.ai
BRIDGE_CONTRACT_MAKALU=0x5832D5E609c6690f74c7683606Eb20F89ff096a6

# ── Production validator keys ────────────────────────────────────────────
# Current candidate: five isolated signer VPSs behind private mTLS endpoints
# with an exact 3-of-5 threshold. Repeat URL, address, CA, client certificate
# and client-key files for indexes 0..4. Historical 5-of-7 deployments are not
# valid production configuration for this candidate.
# The signer address must match the approved on-chain bridge signer set.
# Private validator keys never enter this API container or its environment.
VALIDATOR_SIGNER_URL_0=https://signer-0.multx.internal:9443
VALIDATOR_SIGNER_ADDRESS_0=
VALIDATOR_SIGNER_CA_FILE_0=/run/secrets/signers/signer-0-ca.crt
VALIDATOR_SIGNER_CERT_FILE_0=/run/secrets/signers/signer-0-client.crt
VALIDATOR_SIGNER_KEY_FILE_0=/run/secrets/signers/signer-0-client.key
VALIDATOR_SIGNER_TIMEOUT_MS=8000

# Local development only; rejected when NODE_ENV=production:
VALIDATOR_PRIVATE_KEY_FILE_0=/run/secrets/multx_dev_validator_0

# Mock validator — set true ONLY for local dev, NEVER in production
MOCK_VALIDATOR=false
MOCK_VALIDATOR_COUNT=3
MOCK_SIGNATURES_REQUIRED=2
MOCK_SIGN_DELAY_MS=5000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Faucet is not part of the MultX API production manifest and remains disabled
# on LITHO mainnet.
