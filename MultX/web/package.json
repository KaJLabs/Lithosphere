    "@web3modal/ethers": "^5.1.11",
    "axios": "^1.18.0",
    "bech32": "^2.0.0",
    "chart.js": "^4.3.0",
    "classnames": "^2.3.2",
    "ethers": "^6.13.0",
    "ethers5": "npm:ethers@^5.8.0",
    "lightweight-charts": "^4.0.1",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
